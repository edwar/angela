{
  "name": "angela-react",
  "version": "0.1.0",
  "description": "Componentes de React 19 sobre angela: envoltorios finos de HTML nativo, compatibles con Server Components.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "angela": "workspace:^",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "angela": "workspace:^",
    "happy-dom": "^21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vitest": "~5.0.5"
  }
}
