---
import { codigoPorFramework } from '../lib/codigo-frameworks.js';
import EtiquetaVista from './EtiquetaVista.astro';

interface Props {
  title?: string;
  note?: string;
  code: string;
  /** Posición en la página: da ids únicos a las pestañas de frameworks. */
  index: number;
}
const { title, note, code, index } = Astro.props;
// En el código mostrado, los íconos se abrevian para que se lea el marcado importante.
const shown = code.replace(/<svg[\s\S]*?<\/svg>/g, '<svg aria-hidden="true">…</svg>');
// El mismo ejemplo en cada framework: se muestra abreviado y se copia completo.
const mostrados = codigoPorFramework(shown, title);
const completos = codigoPorFramework(code, title);
const id = `ej-${index}`;
---

<section class="example">
  {
    (title || note) && (
      <div class="example-head">
        {title && <h3>{title}</h3>}
        {note && <p>{note}</p>}
      </div>
    )
  }
  <!-- Los ejemplos muestran angela como la recibe quien la instala, no con el tema del sitio. -->
  <EtiquetaVista />
  <div class="example-preview" data-angela-theme="angela" set:html={code} />
  <!-- data-framework: elegir uno cambia todos los ejemplos (lib/framework-preferido.js). -->
  <div class="tabs example-frameworks">
    <div class="tablist" role="tablist" focusgroup="tablist nomemory" aria-label={`Código${title ? ` de «${title}»` : ''} por framework`}>
      {
        mostrados.map((fw, i) => (
          <button
            type="button"
            role="tab"
            id={`${id}-${fw.id}`}
            data-framework={fw.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            focusgroupstart={i === 0 ? '' : undefined}
          >
            {fw.nombre}
          </button>
        ))
      }
    </div>
    {
      mostrados.map((fw, i) => (
        <div role="tabpanel" aria-labelledby={`${id}-${fw.id}`} hidden={i === 0 ? undefined : 'until-found'}>
          <figure class="example-archivo">
            <figcaption>
              <span class="archivo-ruta">{fw.archivo}</span>
              <span class="archivo-lenguaje">{fw.lenguaje}</span>
            </figcaption>
            <pre
              class="example-code"
              tabindex="0"
              aria-label={`${fw.archivo}${title ? `: ${title}` : ''}`}
              data-copiar={completos[i].codigo !== fw.codigo ? completos[i].codigo : undefined}
            ><code>{fw.codigo}</code></pre>
          </figure>
        </div>
      ))
    }
  </div>
</section>
