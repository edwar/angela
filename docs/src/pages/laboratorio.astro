---
import Layout from '../layouts/Layout.astro';
import { components } from '../data/components.js';
import { icon } from '../data/icons.js';
import { FORMATS, PRESETS } from '../lib/lab/ai.js';
import { MANUAL_CHECKS as manualChecks } from '../lib/lab/review.js';
import { TOKEN_URL } from '../lib/lab/github.js';
import { CATEGORIAS, imagenes, rutaImagen } from '../data/imagenes.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}`;

const quickPrompts = [
  ['Desde una idea', 'Crea un componente de … siguiendo las reglas de angela, con sus variantes y un ejemplo de uso.'],
  ['Accesibilidad', 'Revisa y mejora la accesibilidad (WCAG 2.2 AA): nombres accesibles, teclado, foco y estados que no dependan solo del color.'],
  ['Refactorizar', 'Simplifica el código sin cambiar su comportamiento.'],
  ['Nueva variante', 'Propón una variante nueva y útil, documentada con un ejemplo en el HTML.'],
];

const tabs = [
  { id: 'html', label: 'HTML', file: 'index.html', glyph: '<>' },
  { id: 'css', label: 'CSS', file: 'componente.css', glyph: '#' },
  { id: 'js', label: 'JavaScript', file: 'componente.js', glyph: 'JS' },
];
---

<Layout
  title="Laboratorio"
  description="Escribe un componente de angela, pruébalo aislado y propónlo al proyecto con un pull request."
  heading={false}
>
  <header class="page-header lab-header">
    <div>
      <p class="eyebrow">Diseña · Prueba · Propón</p>
      <h1 id="contenido" tabindex="-1">Laboratorio</h1>
      <span class="cota" aria-hidden="true"></span>
      <p class="page-lead">
        Escribe un componente, pruébalo, revísalo y propónlo al proyecto. El código se ejecuta aislado: sin acceso a esta
        página ni a la red, salvo imágenes por https.
      </p>
    </div>
    <button class="button" type="button" data-variant="ghost" data-tone="neutral" commandfor="lab-settings" command="show-modal">
      <Fragment set:html={icon('settings')} /> Ajustes
    </button>
  </header>

  <section class="lab-step" aria-labelledby="lab-step-start">
    <h2 class="lab-step-title" id="lab-step-start">
      <span class="lab-step-num" aria-hidden="true">01</span><span class="visually-hidden">Paso 1: </span>Punto de partida
    </h2>
    <div class="lab-start">
      <div class="stack lab-start-base plano-marco lab-panel">
        <div class="field">
          <label for="lab-base">Parte de</label>
          <p class="hint" id="lab-base-hint">Un componente de angela para mejorarlo, o uno nuevo desde cero.</p>
          <select class="input" id="lab-base" aria-describedby="lab-base-hint">
            <option value="">Componente nuevo, desde cero</option>
            {components.map((c) => <option value={c.slug}>{c.title}</option>)}
          </select>
        </div>
        <p class="muted lab-status" id="lab-status" role="status"></p>
      </div>

      <section class="stack lab-ai plano-marco lab-panel" aria-labelledby="lab-ai-title">
        <div>
          <h3 id="lab-ai-title">Con ayuda de la IA</h3>
          <p class="muted" id="lab-ai-state"></p>
        </div>
        <form class="stack" id="lab-ai-form">
          <div class="field">
            <label for="lab-ai-prompt">¿Qué quieres que haga?</label>
            <p class="hint" id="lab-ai-prompt-hint">
              Describe un componente nuevo o un cambio sobre el código del editor. La IA sigue las reglas de angela y tú decides si
              aplicas su propuesta.
            </p>
            <textarea class="input" id="lab-ai-prompt" name="instruccion" rows="3" required aria-describedby="lab-ai-prompt-hint"></textarea>
          </div>
          <div class="cluster" role="group" aria-label="Ideas rápidas">
            {
              quickPrompts.map(([label, text]) => (
                <button class="button" type="button" data-variant="soft" data-tone="neutral" data-size="sm" data-prompt={text}>
                  {label}
                </button>
              ))
            }
          </div>
          <div class="cluster">
            <button class="button" type="submit" data-variant="outline" data-tone="neutral" id="lab-ai-submit">Generar código</button>
            <button class="button" type="button" data-variant="ghost" data-tone="neutral" id="lab-ai-cancel" hidden>Cancelar</button>
            <progress class="lab-ai-progress" id="lab-ai-progress" hidden aria-label="Esperando la respuesta"></progress>
          </div>
        </form>
      </section>
    </div>

    <article class="card stack lab-proposal" id="lab-proposal" hidden aria-labelledby="lab-proposal-title">
      <h3 id="lab-proposal-title">Propuesta</h3>
      <p id="lab-proposal-summary"></p>
      <ul id="lab-proposal-changes"></ul>
      <div class="callout" data-tone="warning" id="lab-proposal-warnings" hidden>
        <Fragment set:html={icon('alert')} />
        <div>
          <p class="callout-title">Revisa antes de aplicar</p>
          <ul id="lab-proposal-warning-list"></ul>
        </div>
      </div>
      <details class="disclosure">
        <summary>Ver el código propuesto</summary>
        <div class="stack">
          {
            tabs.map((t) => (
              <section>
                <h4>{t.label}</h4>
                <pre class="lab-proposal-code" tabindex="0" aria-label={`Código ${t.label} propuesto`}><code id={`lab-proposal-${t.id}`} /></pre>
              </section>
            ))
          }
        </div>
      </details>
      <div class="cluster">
        <button class="button" type="button" data-variant="outline" data-tone="neutral" id="lab-proposal-try" aria-pressed="false">
          Probar en la vista previa
        </button>
        <button class="button" type="button" data-variant="ghost" data-tone="neutral" id="lab-proposal-discard">Descartar</button>
        <button class="button" type="button" id="lab-proposal-apply">Aplicar al editor</button>
      </div>
    </article>
  </section>

  <section class="lab-step" aria-labelledby="lab-step-edit">
    <h2 class="lab-step-title" id="lab-step-edit">
      <span class="lab-step-num" aria-hidden="true">02</span><span class="visually-hidden">Paso 2: </span>Escribe y prueba
    </h2>
  <div class="lab-workspace">
    <section class="lab-pane" aria-labelledby="lab-editor-title">
      <h3 class="visually-hidden" id="lab-editor-title">Editor</h3>
      <div class="lab-ide">
        <angela-tabs class="tabs lab-ide-tabs" id="lab-tabs">
          <div class="tablist" role="tablist" focusgroup="tablist nomemory" aria-label="Archivos">
            {
              tabs.map((t, i) => (
                <button type="button" role="tab" id={`lab-tab-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} data-file={t.id} focusgroupstart={i === 0 ? '' : undefined}>
                  <span class="lab-ide-glyph" data-lang={t.id} aria-hidden="true">{t.glyph}</span>
                  <span class="lab-ide-name" data-name={t.id}>{t.file}</span>
                </button>
              ))
            }
          </div>
          {
            tabs.map((t, i) => (
              <div role="tabpanel" aria-labelledby={`lab-tab-${t.id}`} hidden={i === 0 ? undefined : 'until-found'}>
                <div class="lab-ide-editor" id={`lab-code-${t.id}`} data-file={t.id} data-label={`Código ${t.label}`}></div>
              </div>
            ))
          }
        </angela-tabs>
        <div class="lab-ide-status">
          <span id="lab-ide-cursor">Lín. 1, col. 1</span>
          <span>Espacios: 2</span>
          <span>UTF-8</span>
          <span id="lab-ide-lang">HTML</span>
          <span class="lab-ide-saved" id="lab-ide-saved"></span>
        </div>
      </div>
      <div class="cluster">
        <button class="button" type="button" data-variant="outline" data-tone="neutral" data-size="sm" id="lab-imagenes-abrir" aria-haspopup="dialog">
          <Fragment set:html={icon('plus')} /> Insertar imagen
        </button>
      </div>
      <p class="text" data-size="sm" id="lab-parts-state" data-muted role="status"></p>
      <details class="disclosure lab-tips">
        <summary>Atajos y consejos del editor</summary>
        <div class="stack">
          <p class="hint" id="lab-code-hint">
            Emmet: escribe una abreviatura (por ejemplo .tarjeta o ul&gt;li*3) y pulsa Tab. Tab también sangra; Esc y luego
            Tab sale del editor. Se guarda solo mientras escribes.
          </p>
          <p class="hint" id="lab-parts-hint">
            ¿Dos componentes que se usan juntos? Sepáralos en el CSS con
            <code>/* @componente nombre */</code>: se ven juntos aquí y al proponerlos salen como archivos separados.
          </p>
        </div>
      </details>
    </section>

    <section class="lab-pane" aria-labelledby="lab-preview-title">
      <div class="lab-pane-head">
        <h3 id="lab-preview-title">Vista previa</h3>
        <span class="badge" data-tone="info" id="lab-preview-mode" hidden>Propuesta de la IA</span>
        <div class="cluster">
          <button
            class="button"
            type="button"
            data-variant="ghost"
            data-tone="neutral"
            data-icon-only
            id="lab-scheme"
            aria-pressed="false"
          >
            <span data-when="light"><Fragment set:html={icon('moon')} /><span class="visually-hidden">Ver la vista previa en oscuro</span></span>
            <span data-when="dark"><Fragment set:html={icon('sun')} /><span class="visually-hidden">Ver la vista previa en claro</span></span>
          </button>
          <button class="button" type="button" data-variant="ghost" data-tone="danger" id="lab-reset-open" aria-haspopup="dialog">
            <Fragment set:html={icon('trash')} /> Restablecer
          </button>
        </div>
      </div>
      <div class="callout" data-tone="info" id="lab-motion-notice" hidden>
        <Fragment set:html={icon('info')} />
        <div>
          <p class="callout-title">Tu sistema pide menos movimiento</p>
          <p>
            Este componente tiene animación dentro de <code>prefers-reduced-motion: no-preference</code>, así que aquí no
            la verás: se está respetando tu preferencia, como debe ser.
          </p>
          <button class="button" type="button" data-variant="outline" data-tone="neutral" data-size="sm" id="lab-motion-toggle" aria-pressed="false">
            Ver el movimiento igualmente
          </button>
        </div>
      </div>
      <iframe
        class="lab-frame"
        id="lab-frame"
        title="Vista previa del componente"
        sandbox="allow-scripts allow-forms"
        referrerpolicy="no-referrer"></iframe>
      <details class="disclosure lab-console">
        <summary>Consola <span class="badge" data-tone="neutral" id="lab-console-count">0</span></summary>
        <div>
          <ol class="lab-console-list" id="lab-console-list" aria-live="polite"></ol>
          <button class="button" type="button" data-variant="ghost" data-tone="neutral" data-size="sm" id="lab-console-clear">Limpiar</button>
        </div>
      </details>
    </section>
  </div>
  </section>

  <section class="lab-step" aria-labelledby="lab-review-title">
    <h2 class="lab-step-title" id="lab-review-title">
      <span class="lab-step-num" aria-hidden="true">03</span><span class="visually-hidden">Paso 3: </span>Revisa
    </h2>
    <p class="muted lab-step-lead">
      Tres revisiones, de la más rápida a la más fina. Son una ayuda, no un juez: lo último lo decides tú.
    </p>

    <section class="stack lab-review-part" aria-labelledby="lab-auto-review-title">
      <div class="lab-pane-head">
        <h3 id="lab-auto-review-title">Revisión automática</h3>
        <span class="badge" id="lab-review-count" data-tone="neutral">—</span>
      </div>
      <p class="muted">Comprueba en vivo, mientras escribes, las reglas que se pueden verificar con código.</p>
      <ul class="lab-review" id="lab-review-list" role="list" aria-live="polite"></ul>
    </section>

    <section class="lab-ai-review lab-review-part stack" aria-labelledby="lab-ai-review-title">
      <h3 id="lab-ai-review-title">Revisión con IA</h3>
      <p class="muted" id="lab-ai-review-hint">
        Tu agente de IA repasa el HTML, el CSS y el JS contra las reglas de angela. Si algo no cumple, te enseña qué había y
        qué propone, y tú decides si lo aceptas.
      </p>
      <div class="cluster">
        <button class="button" type="button" data-variant="outline" data-tone="neutral" id="lab-ai-review-run" aria-describedby="lab-ai-review-hint">
          <Fragment set:html={icon('check')} /> Revisar con IA
        </button>
        <button class="button" type="button" data-variant="ghost" data-tone="neutral" id="lab-ai-review-cancel" hidden>Cancelar</button>
        <progress class="lab-ai-progress" id="lab-ai-review-progress" hidden aria-label="Esperando la revisión"></progress>
        <p class="muted lab-ai-review-status" id="lab-ai-review-status" role="status"></p>
      </div>

      <div class="callout" data-tone="info" id="lab-ai-review-setup" tabindex="-1" hidden>
        <Fragment set:html={icon('info')} />
        <div>
          <p class="callout-title">Primero configura tu agente de IA</p>
          <p>La revisión usa la IA de Ajustes: la URL de tu API, el modelo y su clave. Sin ellos no se puede revisar.</p>
          <button class="button" type="button" data-variant="outline" data-tone="neutral" data-size="sm" commandfor="lab-settings" command="show-modal">
            <Fragment set:html={icon('settings')} /> Abrir ajustes
          </button>
        </div>
      </div>

      <div class="callout" id="lab-ai-review-ok" tabindex="-1" hidden>
        <Fragment set:html={icon('check').replace('<svg', '<svg data-when="cumple"')} />
        <Fragment set:html={icon('alert').replace('<svg', '<svg data-when="pendiente" hidden')} />
        <div class="stack" style="--stack-gap: var(--space-2)">
          <p class="callout-title" id="lab-ai-review-ok-title"></p>
          <p id="lab-ai-review-ok-summary"></p>
          <details class="disclosure" id="lab-ai-review-checked-box">
            <summary>Qué revisó</summary>
            <ul id="lab-ai-review-checked"></ul>
          </details>
        </div>
      </div>

      <article class="card stack lab-ai-review-changes" id="lab-ai-review-changes" tabindex="-1" hidden aria-labelledby="lab-ai-review-changes-title">
        <h4 id="lab-ai-review-changes-title"></h4>
        <p id="lab-ai-review-summary"></p>
        <div class="callout" data-tone="danger" id="lab-ai-review-api" hidden>
          <Fragment set:html={icon('error')} />
          <div>
            <p class="callout-title">Esta propuesta rompe el componente para quien ya lo usa</p>
            <p>Quita o renombra nombres públicos de los que dependen las páginas que lo usan:</p>
            <ul id="lab-ai-review-api-list"></ul>
            <p>Las reglas de angela no piden cambiarlos. Lo más seguro es rechazarla y volver a revisar.</p>
          </div>
        </div>
        <ol class="lab-ai-review-issues" id="lab-ai-review-issues" role="list"></ol>
        <p class="text" data-size="sm" data-muted id="lab-ai-review-after"></p>
        <div class="callout" data-tone="warning" id="lab-ai-review-warnings" hidden>
          <Fragment set:html={icon('alert')} />
          <div>
            <p class="callout-title">Revisa antes de aceptar</p>
            <ul id="lab-ai-review-warning-list"></ul>
          </div>
        </div>
        <details class="disclosure">
          <summary>Ver todos los cambios, archivo por archivo</summary>
          <div class="stack" id="lab-ai-review-diff"></div>
        </details>
        <div class="cluster">
          <button class="button" type="button" data-variant="ghost" data-tone="neutral" id="lab-ai-review-reject">Rechazar</button>
          <button class="button" type="button" data-variant="outline" data-tone="neutral" id="lab-ai-review-try" aria-pressed="false">
            Probar en la vista previa
          </button>
          <button class="button" type="button" id="lab-ai-review-accept">Aceptar cambios</button>
        </div>
      </article>
    </section>

    <section class="stack lab-review-part" aria-labelledby="lab-manual-review-title">
      <h3 id="lab-manual-review-title">Comprobaciones a mano</h3>
      <p class="muted">Lo que ningún programa revisa por ti. Hazlo antes de proponerlo.</p>
      <ul class="lab-checklist">
        {manualChecks.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </section>

  <section class="lab-step" aria-labelledby="lab-step-propose">
    <h2 class="lab-step-title" id="lab-step-propose">
      <span class="lab-step-num" aria-hidden="true">04</span><span class="visually-hidden">Paso 4: </span>Propón al proyecto
    </h2>
    <p class="muted lab-step-lead">
      Abre un pull request con tu componente, su página de documentación y lo que encontró la revisión. Queda a tu nombre
      y se mezcla cuando pase la revisión del proyecto.
    </p>
    <div class="cluster">
      <button class="button" type="button" id="lab-propose-open">
        <Fragment set:html={icon('upload')} /> Proponer al proyecto
      </button>
      <a class="button" data-variant="ghost" data-tone="neutral" href={href('/contribuir')}>Cómo aportar</a>
    </div>
    <div class="callout lab-done" data-tone="success" id="lab-done" tabindex="-1" hidden>
      <Fragment set:html={icon('check')} />
      <div>
        <p class="callout-title" id="lab-done-title">Pull request abierto</p>
        <p>
          Lo que escribiste ya está en GitHub y el laboratorio empieza de cero.
          <a id="lab-done-link" href="#" target="_blank" rel="noopener">Ver el pull request</a>
        </p>
      </div>
    </div>
  </section>

  <dialog class="dialog" id="lab-settings" data-size="lg" aria-labelledby="lab-settings-title" closedby="any">
    <form class="dialog-form" method="dialog" id="lab-settings-form">
      <header class="dialog-header">
        <h2 id="lab-settings-title">Ajustes</h2>
        <button class="button" type="button" data-variant="ghost" data-tone="neutral" data-icon-only commandfor="lab-settings" command="close" aria-label="Cerrar" set:html={icon('x')} />
      </header>
      <div class="dialog-body stack">
        <div class="callout" data-tone="info">
          <Fragment set:html={icon('info')} />
          <div>
            <p class="callout-title">Tus claves se quedan en tu navegador</p>
            <p>
              La de la IA solo viaja a la URL que pongas aquí; la de GitHub, solo a api.github.com. El código de la vista
              previa no puede leerlas. Usa claves con límite de gasto y no las configures en equipos compartidos.
            </p>
          </div>
        </div>

        <div class="choice">
          <input type="checkbox" id="lab-remember" name="recordar" />
          <label for="lab-remember">
            Recordar las claves en este navegador. Si lo desmarcas, se borran al cerrar la pestaña.
          </label>
        </div>

        <section class="stack" aria-labelledby="lab-settings-ai">
          <h3 id="lab-settings-ai">Modelo de IA</h3>
          <div class="cluster" role="group" aria-label="Configuraciones conocidas">
            {
              PRESETS.map((p) => (
                <button class="button" type="button" data-variant="soft" data-tone="neutral" data-size="sm" data-preset={JSON.stringify(p)}>
                  {p.label}
                </button>
              ))
            }
          </div>
          <p class="hint">
            ¿Sin una clave de pago? Groq tiene una capa gratuita: crea tu clave en{' '}
            <a href="https://console.groq.com/keys" target="_blank" rel="noopener">console.groq.com/keys</a> y elige «Groq
            (gratis)». Permite pocas peticiones por minuto: si llegas al límite, el laboratorio te dice cuánto esperar.
          </p>
          <div class="field">
            <label for="lab-ai-url">URL de la API</label>
            <p class="hint" id="lab-ai-url-hint">El servidor debe permitir llamadas desde el navegador (CORS).</p>
            <input class="input" id="lab-ai-url" name="url" type="url" inputmode="url" spellcheck="false" aria-describedby="lab-ai-url-hint" />
          </div>
          <div class="field">
            <label for="lab-ai-format">Formato de la petición</label>
            <select class="input" id="lab-ai-format" name="formato">
              {FORMATS.map((f) => <option value={f.id}>{f.label}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="lab-ai-model">Modelo</label>
            <input class="input" id="lab-ai-model" name="modelo" spellcheck="false" autocomplete="off" />
          </div>
          <div class="field">
            <label for="lab-ai-key">Clave de la API</label>
            <p class="hint" id="lab-ai-key-hint">Déjala vacía para conservar la que ya tienes guardada.</p>
            <input class="input" id="lab-ai-key" name="clave" type="password" autocomplete="off" spellcheck="false" aria-describedby="lab-ai-key-hint lab-ai-key-state" />
            <p class="text" data-size="sm" id="lab-ai-key-state" role="status"></p>
            <div class="cluster">
              <button class="button" type="button" data-variant="outline" data-tone="neutral" data-size="sm" id="lab-ai-test">
                Probar conexión
              </button>
              <span class="muted" data-size="sm">Hace una petición mínima al modelo.</span>
            </div>
          </div>
        </section>

        <section class="stack" aria-labelledby="lab-settings-gh">
          <h3 id="lab-settings-gh">GitHub</h3>
          <div class="field">
            <label for="lab-gh-token">Token</label>
            <p class="hint" id="lab-gh-token-hint">
              Para abrir el pull request a tu nombre. Necesita permiso sobre repositorios públicos:
              <a href={TOKEN_URL} rel="noopener">crear uno con el permiso justo</a>. Déjalo vacío para conservar el actual.
            </p>
            <input class="input" id="lab-gh-token" name="token" type="password" autocomplete="off" spellcheck="false" aria-describedby="lab-gh-token-hint lab-gh-token-state" />
            <p class="text" data-size="sm" id="lab-gh-token-state" role="status"></p>
          </div>
        </section>

      </div>
      <footer class="dialog-footer">
        <button class="button" type="button" data-variant="ghost" data-tone="danger" id="lab-forget">Olvidar claves</button>
        <button class="button" type="button" data-variant="ghost" data-tone="neutral" commandfor="lab-settings" command="close">Cancelar</button>
        <button class="button" type="submit" value="guardar">Guardar</button>
      </footer>
    </form>
  </dialog>

  <dialog class="dialog" id="lab-propose" data-size="lg" aria-labelledby="lab-propose-title" closedby="any">
    <form class="dialog-form" method="dialog" id="lab-propose-form">
      <header class="dialog-header">
        <h2 id="lab-propose-title">Proponer al proyecto</h2>
        <button class="button" type="button" data-variant="ghost" data-tone="neutral" data-icon-only commandfor="lab-propose" command="close" aria-label="Cerrar" set:html={icon('x')} />
      </header>
      <div class="dialog-body stack">
        <div class="callout" data-tone="danger" id="lab-propose-error" role="alert" tabindex="-1" hidden>
          <Fragment set:html={icon('error')} />
          <div>
            <p class="callout-title">No se pudo abrir el pull request</p>
            <p id="lab-propose-error-text"></p>
            <p id="lab-propose-error-recover" hidden>
              <a id="lab-propose-error-link" href="#" target="_blank" rel="noopener">Abrir el pull request en GitHub</a>
            </p>
          </div>
        </div>
        <p class="muted" id="lab-propose-kind"></p>
        <div class="field" id="lab-propose-parts-field">
          <p class="heading" data-size="md" id="lab-propose-parts-title">Archivos que se van a crear</p>
          <ul class="lab-parts" id="lab-propose-parts" role="list" aria-labelledby="lab-propose-parts-title"></ul>
        </div>
        <div class="field">
          <label for="lab-propose-name">Nombre del componente</label>
          <p class="hint" id="lab-propose-name-hint">Da el nombre del archivo CSS y el título del pull request.</p>
          <input class="input" id="lab-propose-name" name="nombre" required maxlength="40" autocomplete="off" aria-describedby="lab-propose-name-hint lab-propose-name-error" data-error="lab-propose-name-error" />
          <p class="error" id="lab-propose-name-error">Escribe un nombre con al menos una letra o número.</p>
        </div>
        <div class="field">
          <label for="lab-propose-summary">Qué aporta</label>
          <p class="hint" id="lab-propose-summary-hint">Una o dos frases. Es lo primero que lee quien revisa.</p>
          <textarea class="input" id="lab-propose-summary" name="resumen" rows="3" required aria-describedby="lab-propose-summary-hint"></textarea>
        </div>
        <div class="field">
          <label for="lab-propose-a11y">Notas de accesibilidad</label>
          <p class="hint" id="lab-propose-a11y-hint">
            Una por línea: qué hay que saber para usarlo bien (nombres accesibles, teclado, estados). Opcional, pero es
            lo que no se puede leer del código.
          </p>
          <textarea class="input" id="lab-propose-a11y" name="accesibilidad" rows="3" aria-describedby="lab-propose-a11y-hint"></textarea>
        </div>
        <div class="callout" data-tone="warning" id="lab-propose-warnings" hidden>
          <Fragment set:html={icon('alert')} />
          <div>
            <p class="callout-title">La revisión tiene avisos</p>
            <p id="lab-propose-warnings-text"></p>
          </div>
        </div>
      </div>
      <footer class="dialog-footer">
        <p class="muted lab-propose-step" id="lab-propose-step" role="status"></p>
        <button class="button" type="button" data-variant="ghost" data-tone="neutral" commandfor="lab-propose" command="close">Cancelar</button>
        <button class="button" type="submit" value="proponer" id="lab-propose-send">Abrir pull request</button>
      </footer>
    </form>
  </dialog>
  <dialog class="dialog" id="lab-imagenes" data-size="lg" aria-labelledby="lab-imagenes-title" closedby="any">
    <header class="dialog-header">
      <h2 id="lab-imagenes-title">Insertar imagen</h2>
      <button class="button" type="button" data-variant="ghost" data-tone="neutral" data-icon-only commandfor="lab-imagenes" command="close" aria-label="Cerrar" set:html={icon('x')} />
    </header>
    <div class="dialog-body">
      <p class="muted">Fotos de dominio público (CC0). Elige una y se inserta su &lt;img&gt;, con texto alternativo, donde está el cursor del HTML.</p>
      <div class="cluster lab-imagenes-filtros">
        <div class="field">
          <label for="lab-imagenes-tamano">Tamaño</label>
          <select class="input" id="lab-imagenes-tamano">
            <option value="">Grande · 720×480</option>
            <option value="360">Miniatura · 360×240</option>
            <option value="cuadrada">Avatar · 320×320 (personas)</option>
          </select>
        </div>
        <div class="field">
          <label for="lab-imagenes-categoria">Categoría</label>
          <select class="input" id="lab-imagenes-categoria">
            <option value="">Todas</option>
            {CATEGORIAS.map((c) => <option value={c.id}>{c.nombre}</option>)}
          </select>
        </div>
      </div>
      <ul class="lab-imagenes-rejilla" id="lab-imagenes-rejilla" role="list">
        {
          imagenes.map((img) => (
            <li data-categoria={img.categoria} data-cuadrada={img.cuadrada ? '' : undefined}>
              <button type="button" data-id={img.id} data-alt={img.alt} aria-label={`Insertar «${img.alt}»`}>
                <img src={rutaImagen(img, '360')} data-normal={rutaImagen(img, '360')} data-cuadrada={img.cuadrada ? rutaImagen(img, 'cuadrada') : undefined} alt="" width="360" height="240" loading="lazy" decoding="async" />
              </button>
            </li>
          ))
        }
      </ul>
    </div>
    <footer class="dialog-footer">
      <a class="button" data-variant="ghost" data-tone="neutral" href={href('/imagenes')} target="_blank">Ver todas y sus créditos</a>
      <button class="button" type="button" data-variant="ghost" data-tone="neutral" commandfor="lab-imagenes" command="close">Cancelar</button>
    </footer>
  </dialog>

  <dialog class="dialog" id="lab-reset" data-size="sm" aria-labelledby="lab-reset-title" aria-describedby="lab-reset-desc" closedby="any">
    <div class="dialog-body stack" style="--stack-gap: var(--space-3)">
      <h2 id="lab-reset-title" style="font-size: var(--fs-lg); margin: 0">¿Restablecer el código?</h2>
      <p id="lab-reset-desc"></p>
      <div id="lab-reset-loss">
        <p class="text" data-weight="bold">Se perderá:</p>
        <ul id="lab-reset-list"></ul>
      </div>
      <div class="callout" data-tone="warning">
        <Fragment set:html={icon('alert')} />
        <div>
          <p class="callout-title">No se puede deshacer</p>
          <p id="lab-reset-warning">Si quieres conservar algo, cópialo antes de continuar.</p>
        </div>
      </div>
    </div>
    <form class="dialog-footer" method="dialog">
      <button class="button" value="cancelar" data-variant="ghost" data-tone="neutral" autofocus>Cancelar</button>
      <button class="button" value="restablecer" data-tone="danger" id="lab-reset-confirm">Restablecer el código</button>
    </form>
  </dialog>
</Layout>

<script>
  import { startLab } from '../lib/lab/app.js';
  const cleanup = startLab();
  // En desarrollo, al recargar el módulo en caliente no deben quedar dos instancias escuchando.
  import.meta.hot?.dispose(cleanup);
</script>
