---
import '@angela-ui/angela/source.css';
// Títulos condensados del estilo «plano», alojados en el sitio (sin peticiones a terceros).
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '../styles/docs.css';
import { themeInlineScript } from '@angela-ui/angela/js/theme';
import { components } from '../data/components.js';
import { icon } from '../data/icons.js';

interface Props {
  title: string;
  description: string;
  /** Si es false, la página pone su propio <h1>. */
  heading?: boolean;
  /** Etiqueta pequeña sobre el título, como la leyenda de un plano. */
  eyebrow?: string;
}

const { title, description, heading = true, eyebrow = 'angela · documentación' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const href = (p: string) => `${base}${p}`;
const isCurrent = (p: string) => (path === `${base}${p}`.replace(/\/$/, '') || (p === '/' && path === (base || '/')));

const nav = [
  { label: 'Inicio', href: '/' },
  { label: 'Guía de diseño', href: '/guia' },
  { label: 'Componentes', href: '/componentes' },
  { label: 'Imágenes', href: '/imagenes' },
  { label: 'Iconos', href: '/iconos' },
  { label: 'Laboratorio', href: '/laboratorio' },
  { label: 'Cómo aportar', href: '/contribuir' },
];
---

<!doctype html>
<!-- data-angela-theme="plano": el tema del sitio. La librería sigue con sus valores por defecto. -->
<html lang="es" data-angela-theme="plano">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Esquemas soportados, antes de pintar. El script siguiente aplica la preferencia guardada. -->
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={themeInlineScript} />
    <title>{title === 'angela' ? 'angela · componentes sobre HTML nativo' : `${title} · angela`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link visually-hidden" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="site-header-inner">
        <button
          class="button nav-toggle"
          type="button"
          data-variant="ghost"
          data-tone="neutral"
          data-icon-only
          commandfor="site-nav"
          command="toggle-popover"
          aria-label="Navegación"
          set:html={icon('menu')}
        />
        <a class="site-logo" href={href('/')}>
          <svg class="site-logo-mark" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" />
            <path d="M12 0v7M12 17v7M0 12h7M17 12h7" />
            <circle cx="12" cy="12" r="2.5" />
          </svg>
          angela
        </a>
        <span class="badge" data-variant="outline" data-tone="brand">v0.1</span>
        <div class="site-header-actions">
          <button
            class="button"
            type="button"
            data-variant="ghost"
            data-tone="neutral"
            data-icon-only
            data-theme-toggle
          >
            <span data-when="light"><Fragment set:html={icon('moon')} /><span class="visually-hidden">Cambiar a tema oscuro</span></span>
            <span data-when="dark"><Fragment set:html={icon('sun')} /><span class="visually-hidden">Cambiar a tema claro</span></span>
          </button>
        </div>
      </div>
    </header>

    <div class="site">
      <nav class="site-nav" id="site-nav" popover aria-label="Documentación">
        <ul role="list">
          {
            nav.map((item) => (
              <li>
                <a href={href(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="site-nav-heading" id="nav-componentes">Componentes</p>
        <ul role="list" aria-labelledby="nav-componentes">
          {
            components.map((c) => (
              <li>
                <a
                  href={href(`/componentes/${c.slug}`)}
                  aria-current={isCurrent(`/componentes/${c.slug}`) ? 'page' : undefined}
                >
                  {c.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <main class="site-main">
        {
          heading && (
            <header class="page-header">
              <p class="eyebrow">{eyebrow}</p>
              <h1 id="contenido" tabindex="-1">
                {title}
              </h1>
              <p class="page-lead">{description}</p>
            </header>
          )
        }
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <p class="site-footer-motto" aria-hidden="true">Diseña · Prueba · Propón</p>
      <p class="muted">angela · componentes sobre HTML nativo. Hecho con la plataforma web.</p>
    </footer>

    <script>
      import { angela } from '@angela-ui/angela/js';
      angela();
    </script>
  </body>
</html>
